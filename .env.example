# Auth — 64-char hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Server
PORT=3100
RATE_LIMIT_RPM=120

# Timezone used to compute "start of day" for Leitner scheduling (IANA name).
APP_TIMEZONE=Europe/Amsterdam

# Google Gemini key for quiz generation (server-side; keeps it off the device).
GEMINI_API_KEY=

# Optional: override the SQLite path (defaults to ./data/essential-words.sqlite)
# DB_PATH=/home/medhibahrami/essential-words-api/data/essential-words.sqlite
